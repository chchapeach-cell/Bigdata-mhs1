# ============================================================================
# MHS1 BIGDATA - APACHE SECURITY HEADERS & URL REWRITING CONFIGURATION
# สำหรับการ Deploy บน Hostatom / cPanel / DirectAdmin / Apache 2.4+
# ============================================================================

# 1. SECURITY HEADERS (ป้องกันช่องโหว่ความปลอดภัยระดับสูงสุด)
<IfModule mod_headers.c>
  # ป้องกัน Clickjacking / Framing Protection
  Header set X-Frame-Options "SAMEORIGIN"

  # ป้องกัน MIME-type Sniffing
  Header set X-Content-Type-Options "nosniff"

  # ควบคุมการส่งต่อข้อมูล Referrer
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # กำหนดสิทธิ์การเข้าถึงอุปกรณ์ (อนุญาต GPS สำหรับดึงพิกัดโรงเรียน)
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=()"

  # กำหนด Content Security Policy (CSP) รองรับ React SPA, Google Fonts, Maps Iframe และ REST APIs
  Header set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https: wss:; frame-src 'self' https://www.google.com https://maps.google.com;"

  # ลบข้อมูลระบุเวอร์ชันเซิร์ฟเวอร์
  Header unset X-Powered-By
</IfModule>

# 2. URL REWRITING (สำหรับ React Single Page Application)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# 3. GZIP COMPRESSION (เพิ่มความเร็วการโหลดเว็บสูงสุด 5-10 เท่า)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 4. BROWSER CACHING (แคชไฟล์คงที่เพื่อลดภาระเซิร์ฟเวอร์)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
